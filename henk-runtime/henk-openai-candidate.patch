@@ -359,0 +360,13 @@ def _run_model(worker, cfg, message):
+    if message.get('kind') == 'digest':
+        if cfg.get('_operations_enabled'):
+            require_running()
+        prefix = 'REDMINE_DIGEST_V1:'
+        body = message.get('body', '')
+        if not isinstance(body, str) or not body.startswith(prefix):
+            raise ValueError('digest_input_invalid')
+        data = json.loads(body[len(prefix):])
+        if not isinstance(data, dict) or set(data) != {'context', 'model'} or not isinstance(data['context'], dict) or not isinstance(data['model'], str):
+            raise ValueError('digest_input_invalid')
+        from henk_openai import summarize
+        yield {'kind': 'answer', 'body': summarize(data['context'], message['id'], data['model'])}
+        return
