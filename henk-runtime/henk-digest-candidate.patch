diff --git a/agent-bridge-v2/tests/test_worker.py b/agent-bridge-v2/tests/test_worker.py
index 0830235..a30def0 100644
--- a/agent-bridge-v2/tests/test_worker.py
+++ b/agent-bridge-v2/tests/test_worker.py
@@ -331,0 +332,14 @@ class PolicyTests(unittest.TestCase):
+    def test_redmine_digest_command_disables_tools_and_uses_read_only_profile(self):
+        executable = str(Path(sys.executable).resolve())
+        cfg = {'codex': executable, 'model': 'synthetic', '_redmine_digest_no_tools': True}
+        command = w.model_command(cfg, Path('/tmp'))
+        values = ' '.join(command)
+        self.assertIn('features.shell_tool=false', values)
+        self.assertIn('features.unified_exec=false', values)
+        self.assertIn('features.code_mode_host=false', values)
+        self.assertIn('features.view_image=false', values)
+        self.assertIn(':read-only', values)
+        self.assertIn('mcp_servers={}', values)
+        with self.assertRaises(Exception):
+            w.model_command({**cfg, '_mcp_session': object()}, Path('/tmp'))
+
